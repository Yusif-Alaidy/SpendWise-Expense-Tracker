@SpendWise.Api_HostAddress = http://localhost:5075

GET {{SpendWise.Api_HostAddress}}/weatherforecast/
Accept: application/json

### Register - success
POST {{SpendWise.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "displayName": "Test User",
  "password": "Password1"
}

### Register - duplicate
POST {{SpendWise.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "displayName": "Test User",
  "password": "Password1"
}

### Register - weak password
POST {{SpendWise.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "weak@example.com",
  "displayName": "Weak",
  "password": "weak"
}

### Login - success
POST {{SpendWise.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password1"
}

### Login - wrong password
POST {{SpendWise.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "WrongPass1"
}

### Me - no token
GET {{SpendWise.Api_HostAddress}}/api/auth/me

### Me - with token
GET {{SpendWise.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}

### Login - get token and create account/category
### (use the returned token for subsequent requests by replacing {{token}})

### Create Account
POST {{SpendWise.Api_HostAddress}}/api/accounts
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Main Wallet",
  "type": "Cash",
  "openingBalance": 100.00
}

### List Accounts
GET {{SpendWise.Api_HostAddress}}/api/accounts
Authorization: Bearer {{token}}

### Get Account
GET {{SpendWise.Api_HostAddress}}/api/accounts/1
Authorization: Bearer {{token}}

### Update Account
PUT {{SpendWise.Api_HostAddress}}/api/accounts/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Main Wallet Updated",
  "type": "Cash",
  "openingBalance": 50.00
}

### Delete Account
DELETE {{SpendWise.Api_HostAddress}}/api/accounts/1
Authorization: Bearer {{token}}

### Create Category
POST {{SpendWise.Api_HostAddress}}/api/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Custom",
  "type": "Expense",
  "color": "#123ABC"
}

### List Categories
GET {{SpendWise.Api_HostAddress}}/api/categories
Authorization: Bearer {{token}}

### Get Category
GET {{SpendWise.Api_HostAddress}}/api/categories/1
Authorization: Bearer {{token}}

### Update Category
PUT {{SpendWise.Api_HostAddress}}/api/categories/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Custom Updated",
  "color": "#FFFFFF"
}

### Delete Category
DELETE {{SpendWise.Api_HostAddress}}/api/categories/1
Authorization: Bearer {{token}}


