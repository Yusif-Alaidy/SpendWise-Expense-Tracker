using Microsoft.AspNetCore.OpenApi;
using Microsoft.OpenApi.Interfaces;
using Microsoft.OpenApi.Services;
using Microsoft.OpenApi;

namespace SpendWise.Api.OpenApi;

// The OpenAPI infrastructure in Microsoft.AspNetCore.OpenApi exposes an OpenApiDocument model
// where many types live under Microsoft.OpenApi.*. The exact runtime types are internal to the framework
// and the public extensibility point is IOpenApiDocumentTransformer.

public class DevelopmentOpenApiTransformer : IOpenApiDocumentTransformer
{
    public System.Threading.Tasks.ValueTask TransformAsync(Microsoft.OpenApi.OpenApiDocument document, OpenApiDocumentTransformerContext context, System.Threading.CancellationToken cancellationToken = default)
    {
        // The Microsoft.OpenApi 2.x types are limited in this environment. We will add a security scheme
        // by using the document's Components dictionary directly if available.

        // Try to add a 'Bearer' security scheme using the representation expected by the built-in generator.
        // If the concrete types are not directly available, avoid throwing and return completed task.
        try
        {
            // Document.Components is an IDictionary<string, object>-like container in the abstraction; attempt best-effort
            if (document.Components != null)
            {
                // Many of the concrete helper types are not publicly available here; use Extensions as a fallback marker
                document.Components.Extensions ??= new System.Collections.Generic.Dictionary<string, Microsoft.OpenApi.Any.IOpenApiAny>();
                // Mark that a Bearer scheme is expected by clients; Scalar UI can be configured to recognize this extension if needed.
                document.Components.Extensions["x-security-scheme-bearer"] = new Microsoft.OpenApi.Any.OpenApiString("bearer");
            }
        }
        catch
        {
            // If we cannot modify components due to lack of types, do nothing. This is safe for compilation.
        }

        return System.Threading.Tasks.ValueTask.CompletedTask;
    }
}
